---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import faq from '../data/faq.json';
import { withBase } from '../lib/url';
const services = (await getCollection('pages')).filter((p) => p.data.kind === 'service').sort((a, b) => a.data.order - b.data.order);
const steps = [['You send your real history','A current CV or a plain list of roles, dates and responsibilities, plus the job you want.'],['We tailor and sharpen','We organise it, tighten the wording and focus it on your target role. We ask when something is unclear.'],['You check every line','Anything not accurate is corrected or removed before you use it.']];
const jsonLd = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.slice(0,4).map((f)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
---
<Base title="CV and LinkedIn Studio | Honest career documents" description="CV, cover letter, LinkedIn and interview prep support, tailored to your real experience. Nothing invented, nothing inflated." jsonLd={jsonLd}>
<section class="hero"><div class="wrap">
<div>
<p class="eyebrow">CV, cover letter, LinkedIn, interview prep</p>
<h1 class="display">Tailored CVs, built from your real experience.</h1>
<p class="lead">You bring the history. We sharpen the wording and aim it at the role. We never invent jobs, titles, dates, metrics or skills.</p>
<div class="actions"><a class="btn" href={withBase('enquire/')}>Request a quote</a><a class="btn btn--ghost" href={withBase('how-it-works/')}>How it works</a></div>
<small>Quote-based. No payment is taken on this site.</small>
</div>
<div class="mock" aria-hidden="true">
<div class="doc">
<div class="who"><span class="avatar"></span><span class="ph">Your name<small>Your role</small></span></div>
<h4>Profile</h4><div class="bar"></div><div class="bar m"></div><div class="bar s"></div>
<h4>Experience</h4><div class="ph">Your role, Your employer<small>Your dates</small></div><div class="bar"></div><div class="bar m"></div>
<h4>Skills</h4><span class="chip">Your skill</span><span class="chip">Your skill</span><span class="chip">Your skill</span>
</div>
<div class="badge"><b>Checked against you</b>Every line traces back to what you told us.</div>
</div>
</div></section>

<section class="band"><div class="wrap">
<div class="head"><p class="eyebrow">Services</p><h2>Four ways we can help</h2><p>Each one starts from your real history. Every service is quoted individually.</p></div>
<div class="grid g4">{services.map((s)=><a class="card" href={withBase(s.id+'/')}><Icon name={s.data.icon} /><h3>{s.data.title.split(' | ')[0]}</h3><p>{s.data.summary}</p><span class="more">Learn more</span></a>)}</div>
</div></section>

<section class="band band--tint"><div class="wrap">
<div class="head"><p class="eyebrow">How it works</p><h2>A simple, honest process</h2></div>
<ol class="steps">{steps.map(([t,d])=><li><h3>{t}</h3><p>{d}</p></li>)}</ol>
</div></section>

<section class="band band--ink"><div class="wrap">
<div class="head"><p class="eyebrow">Our promise</p><h2>No embellishment. Ever.</h2></div>
<div class="principles">
<div><h3>Only what is true</h3><p>If it is not in your history, it is not in your document.</p></div>
<div><h3>You stay in control</h3><p>You review every draft and correct anything that is off.</p></div>
<div><h3>Private by default</h3><p>Your details are not fed to external AI models.</p></div>
<div><h3>Honest about outcomes</h3><p>We make no promise of interviews or job offers.</p></div>
</div></div></section>

<section class="band"><div class="wrap"><div class="prose">
<div class="head"><p class="eyebrow">FAQ</p><h2>Common questions</h2></div>
<Faq items={faq.slice(0,4)} />
<p><a class="more" href={withBase('faq/')}>See all questions</a></p>
</div></div></section>
</Base>
