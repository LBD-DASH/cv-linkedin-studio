---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
export async function getStaticPaths() {
  return (await getCollection('pages')).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const name = d.title.split(' | ')[0];
---
{d.kind === 'service' ? (
<Base title={d.title} description={d.description}>
<section class="page-hero"><div class="wrap two">
<div>
<p class="crumbs"><a href={withBase('')}>Home</a> / Services / {name}</p>
<h1 set:html={d.headline.replace(/\*(.+?)\*/g,'<em>$1</em>')} />
<p class="lead">{d.lead}</p>
<div class="actions"><a class="btn btn--light" href={withBase('enquire/')}>Request a quote</a><a class="btn btn--ghost" href={withBase('how-it-works/')}>How it works</a></div>
</div>
<div class="mini" aria-hidden="true"><span class="tag">Example</span><small>{d.example.label}, before</small><p class="del">{d.example.before}</p><small>After</small><p><span class="ins">{d.example.after}</span></p></div>
</div></section>
<section class="band"><div class="wrap grid g2">
<div><p class="eyebrow l">Who it is for</p><h2>Is this <em>right</em> for you?</h2><ul class="tick">{d.audience.map((a)=><li>{a}</li>)}</ul></div>
<div><p class="eyebrow l">What you get</p><h2>The work, <em>plainly</em></h2><ul class="tick">{d.gets.map((a)=><li>{a}</li>)}</ul></div>
</div></section>
<section class="band band--paper2"><div class="wrap">
<div class="head"><p class="eyebrow l">Process</p><h2>How we work <em>on it</em></h2></div>
<ol class="steps">{d.process.map((s)=><li><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
</div></section>
<section class="band"><div class="wrap">
<div class="head"><p class="eyebrow l">Margin notes</p><h2>What we will and will <em>not</em> do</h2></div>
<div class="margin-notes">{d.notes.map((n)=><div class="mn"><b>Note</b>{n}</div>)}</div>
</div></section>
</Base>
) : (
<Base title={d.title} description={d.description}>
<section class="page-hero"><div class="wrap"><p class="crumbs"><a href={withBase('')}>Home</a> / {name}</p><h1>{name}</h1><p class="lead" style="margin:0">{d.description}</p></div></section>
<div class="wrap article"><div class="prose"><Content /></div></div>
</Base>
)}
